#!/bin/bash

set -e

VERSION="1.0.0"

# 默认配置
DEFAULT_TARGET_BRANCH="main"
FEATURE_PREFIX="version/"
HOTFIX_PREFIX="hotfix/"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 日志函数
log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# 检查依赖
check_dependencies() {
    command -v glab >/dev/null || { log_error "glab is required but not installed"; exit 1; }
    command -v git >/dev/null || { log_error "git is required but not installed"; exit 1; }
}

# 获取 git 根目录
get_git_root() {
    git rev-parse --show-toplevel 2>/dev/null
}

# 加载项目配置
load_config() {
    local git_root=$(get_git_root)
    if [ -z "$git_root" ]; then
        log_error "Not in a git repository"
        exit 1
    fi
    
    local config_file="$git_root/.flow3/config"
    if [ -f "$config_file" ]; then
        log_info "Loading project config from $config_file"
        source "$config_file"
    fi
}

# 保存分支和milestone关联
save_branch_milestone() {
    local branch="$1"
    local milestone="$2"
    local git_root=$(get_git_root)
    [ -z "$git_root" ] && return 1
    
    mkdir -p "$git_root/.flow3"
    echo "$branch:$milestone" >> "$git_root/.flow3/branch_milestones"
}

# 获取分支关联的milestone
get_branch_milestone() {
    local branch="$1"
    local git_root=$(get_git_root)
    [ -z "$git_root" ] && return 1
    
    if [ -f "$git_root/.flow3/branch_milestones" ]; then
        grep "^$branch:" "$git_root/.flow3/branch_milestones" | cut -d':' -f2
    fi
}

# 移除分支milestone关联
remove_branch_milestone() {
    local branch="$1"
    local git_root=$(get_git_root)
    [ -z "$git_root" ] && return 1
    
    if [ -f "$git_root/.flow3/branch_milestones" ]; then
        grep -v "^$branch:" "$git_root/.flow3/branch_milestones" > "$git_root/.flow3/branch_milestones.tmp" || true
        mv "$git_root/.flow3/branch_milestones.tmp" "$git_root/.flow3/branch_milestones"
    fi
}

# 检查 MR 是否已存在并返回链接
check_mr_exists() {
    local source_branch="$1"
    local target_branch="$2"
    
    local mr_info=$(glab api "projects/:id/merge_requests?state=opened&source_branch=$source_branch&target_branch=$target_branch" 2>/dev/null)
    local count=$(echo "$mr_info" | jq -r 'length' 2>/dev/null || echo "0")
    
    if [ "$count" != "0" ]; then
        echo "$mr_info" | jq -r '.[0].web_url' 2>/dev/null
        return 0
    else
        return 1
    fi
}

# 获取当前分支
get_current_branch() {
    git branch --show-current
}

# 功能：开始 feature
feature_start() {
    local name="$1"
    local desc="$2"
    
    [ -z "$name" ] && { log_error "Feature name is required"; exit 1; }
    
    local branch_name="${FEATURE_PREFIX}${name}"
    
    log_info "Starting feature: $name"
    
    # 切换到主分支并更新
    git checkout "$DEFAULT_TARGET_BRANCH"
    git pull origin "$DEFAULT_TARGET_BRANCH"
    
    # 检查分支是否已存在
    if git show-ref --verify --quiet "refs/heads/$branch_name"; then
        log_warn "Branch $branch_name already exists locally, switching to it"
        git checkout "$branch_name"
    elif git ls-remote --heads origin "$branch_name" | grep -q "$branch_name"; then
        log_warn "Branch $branch_name exists on remote, checking it out"
        git checkout -b "$branch_name" "origin/$branch_name"
    else
        # 创建新分支
        git checkout -b "$branch_name"
        
        # 推送分支到远端
        git push -u origin "$branch_name"
        
        log_info "Created branch: $branch_name"
    fi
    
    # 创建 milestone
    local milestone_desc="${desc:-Feature: $name}"
    log_info "Creating milestone: $name"
    local milestone_result=$(glab api "projects/:id/milestones" --method POST --field "title=$name" --field "description=$milestone_desc" 2>/dev/null)
    
    if [ $? -eq 0 ] && [ -n "$milestone_result" ]; then
        local milestone_id=$(echo "$milestone_result" | jq -r '.id // empty' 2>/dev/null)
        if [ -n "$milestone_id" ] && [ "$milestone_id" != "null" ]; then
            save_branch_milestone "$branch_name" "$milestone_id"
            log_info "Created milestone #$milestone_id and associated with branch"
        else
            log_warn "Failed to extract milestone ID"
        fi
    else
        log_warn "Failed to create milestone"
    fi
}

# 功能：完成 feature
feature_finish() {
    local target="$DEFAULT_TARGET_BRANCH"
    local force_create=false
    local auto_merge=false
    
    # 解析参数
    while [[ $# -gt 0 ]]; do
        case $1 in
            --force-create-mr)
                force_create=true
                shift
                ;;
            --auto-merge)
                auto_merge=true
                shift
                ;;
            *)
                target="$1"
                shift
                ;;
        esac
    done
    
    local current_branch=$(get_current_branch)
    
    # 检查是否在 feature 分支
    if [[ ! "$current_branch" =~ ^${FEATURE_PREFIX} ]]; then
        log_error "Not on a feature branch"
        exit 1
    fi
    
    log_info "Finishing feature: $current_branch"
    
    # 推送当前分支
    git push -u origin "$current_branch"
    
    local mr_url=""
    
    # 检查 MR 是否已存在（除非强制创建）
    if [ "$force_create" = false ]; then
        local existing_mr
        existing_mr=$(check_mr_exists "$current_branch" "$target") || true
        local check_result=$?
        
        if [ $check_result -eq 0 ] && [ -n "$existing_mr" ]; then
            log_warn "Merge request already exists for $current_branch -> $target"
            mr_url="$existing_mr"
        fi
    fi
    
    # 创建 MR（如果不存在或强制创建）
    if [ -z "$mr_url" ]; then
        log_info "Creating merge request"
        
        # 获取关联的milestone
        local milestone=$(get_branch_milestone "$current_branch")
        
        if [ -n "$milestone" ]; then
            log_info "Using associated milestone: $milestone"
            if [ "$auto_merge" = true ]; then
                mr_url=$(glab mr create --title "${current_branch#$FEATURE_PREFIX}" --description "Feature: ${current_branch#$FEATURE_PREFIX}" --source-branch "$current_branch" --target-branch "$target" --milestone "$milestone" --assignee "@me" --remove-source-branch --yes 2>/dev/null | grep -o 'https://[^[:space:]]*')
            else
                mr_url=$(glab mr create --title "${current_branch#$FEATURE_PREFIX}" --description "Feature: ${current_branch#$FEATURE_PREFIX}" --source-branch "$current_branch" --target-branch "$target" --milestone "$milestone" --assignee "@me" --yes 2>/dev/null | grep -o 'https://[^[:space:]]*')
            fi
        else
            if [ "$auto_merge" = true ]; then
                mr_url=$(glab mr create --title "${current_branch#$FEATURE_PREFIX}" --description "Feature: ${current_branch#$FEATURE_PREFIX}" --source-branch "$current_branch" --target-branch "$target" --assignee "@me" --remove-source-branch --yes 2>/dev/null | grep -o 'https://[^[:space:]]*')
            else
                mr_url=$(glab mr create --title "${current_branch#$FEATURE_PREFIX}" --description "Feature: ${current_branch#$FEATURE_PREFIX}" --source-branch "$current_branch" --target-branch "$target" --assignee "@me" --yes 2>/dev/null | grep -o 'https://[^[:space:]]*')
            fi
        fi
        
        [ -n "$mr_url" ] || log_warn "Failed to create MR"
    fi
    
    # 输出 MR 链接
    [ -n "$mr_url" ] && echo "$mr_url"
    
    # 自动合并 MR
    if [ "$auto_merge" = true ] && [ -n "$mr_url" ]; then
        local mr_id=$(echo "$mr_url" | grep -o '[0-9]*$')
        if [ -n "$mr_id" ]; then
            log_info "Auto-merging MR #$mr_id"
            glab mr merge "$mr_id" --yes --remove-source-branch || log_warn "Failed to auto-merge MR"
        fi
    fi
    
    # 清理分支milestone关联
    remove_branch_milestone "$current_branch"
}

# 热修复：开始
hotfix_start() {
    local name="$1"
    local desc="$2"
    
    [ -z "$name" ] && { log_error "Hotfix name is required"; exit 1; }
    
    local branch_name="${HOTFIX_PREFIX}${name}"
    
    log_info "Starting hotfix: $name"
    
    git checkout "$DEFAULT_TARGET_BRANCH"
    git pull origin "$DEFAULT_TARGET_BRANCH"
    
    # 检查分支是否已存在
    if git show-ref --verify --quiet "refs/heads/$branch_name"; then
        log_warn "Branch $branch_name already exists locally, switching to it"
        git checkout "$branch_name"
    elif git ls-remote --heads origin "$branch_name" | grep -q "$branch_name"; then
        log_warn "Branch $branch_name exists on remote, checking it out"
        git checkout -b "$branch_name" "origin/$branch_name"
    else
        git checkout -b "$branch_name"
        
        # 推送分支到远端
        git push -u origin "$branch_name"
        
        log_info "Created hotfix branch: $branch_name"
    fi
    
    # 创建 issue
    local issue_desc="${desc:-Hotfix: $name}"
    log_info "Creating issue: $name"
    local issue_result=$(glab issue create --title "$name" --description "$issue_desc" --assignee "@me" --output json 2>/dev/null)
    
    if [ $? -eq 0 ] && [ -n "$issue_result" ]; then
        local issue_id=$(echo "$issue_result" | jq -r '.iid // empty' 2>/dev/null)
        if [ -n "$issue_id" ] && [ "$issue_id" != "null" ]; then
            save_branch_milestone "$branch_name" "$issue_id"
            log_info "Created issue #$issue_id and associated with branch"
        else
            log_warn "Failed to extract issue ID"
        fi
    else
        log_warn "Failed to create issue"
    fi
}

# 热修复：完成
hotfix_finish() {
    local target="$DEFAULT_TARGET_BRANCH"
    local force_create=false
    local auto_merge=false
    
    # 解析参数
    while [[ $# -gt 0 ]]; do
        case $1 in
            --force-create-mr)
                force_create=true
                shift
                ;;
            --auto-merge)
                auto_merge=true
                shift
                ;;
            *)
                target="$1"
                shift
                ;;
        esac
    done
    
    local current_branch=$(get_current_branch)
    
    if [[ ! "$current_branch" =~ ^${HOTFIX_PREFIX} ]]; then
        log_error "Not on a hotfix branch"
        exit 1
    fi
    
    log_info "Finishing hotfix: $current_branch"
    
    git push -u origin "$current_branch"
    
    # 获取关联的issue
    local issue_id=$(get_branch_milestone "$current_branch")
    local mr_url=""
    
    # 检查 MR 是否已存在（除非强制创建）
    if [ "$force_create" = false ]; then
        local existing_mr
        existing_mr=$(check_mr_exists "$current_branch" "$target") || true
        local check_result=$?
        
        if [ $check_result -eq 0 ] && [ -n "$existing_mr" ]; then
            log_warn "Merge request already exists for $current_branch -> $target"
            mr_url="$existing_mr"
        fi
    fi
    
    # 创建 MR（如果不存在或强制创建）
    if [ -z "$mr_url" ]; then
        local mr_args="--title Hotfix: ${current_branch#$HOTFIX_PREFIX} --source-branch $current_branch --target-branch $target --assignee @me --yes"
        
        # 添加自动合并参数
        if [ "$auto_merge" = true ]; then
            mr_args="$mr_args --remove-source-branch"
        fi
        
        if [ -n "$issue_id" ]; then
            log_info "Using associated issue: #$issue_id"
            mr_url=$(glab mr create $mr_args --description "Closes #$issue_id" 2>/dev/null | grep -o 'https://[^[:space:]]*')
        else
            mr_url=$(glab mr create $mr_args --description "Hotfix: ${current_branch#$HOTFIX_PREFIX}" 2>/dev/null | grep -o 'https://[^[:space:]]*')
        fi
        
        [ -n "$mr_url" ] || log_warn "Failed to create MR"
    fi
    
    # 输出 MR 链接
    [ -n "$mr_url" ] && echo "$mr_url"
    
    # 自动合并 MR
    if [ "$auto_merge" = true ] && [ -n "$mr_url" ]; then
        local mr_id=$(echo "$mr_url" | grep -o '[0-9]*$')
        if [ -n "$mr_id" ]; then
            log_info "Auto-merging MR #$mr_id"
            glab mr merge "$mr_id" --yes --remove-source-branch || log_warn "Failed to auto-merge MR"
        fi
    fi
    
    # 清理分支关联
    remove_branch_milestone "$current_branch"
}

# 同步 milestones
sync_milestones() {
    log_info "Syncing milestones..."
    glab api "projects/:id/milestones?state=active" | \
        jq -r '.[] | "\(.id): \(.title) - \(.description // "No description")"'
}

# 显示帮助
show_help() {
    cat << EOF
Flow3 v$VERSION - GitLab workflow tool based on glab (3rd generation)

USAGE:
    flow3 <command> [options]

COMMANDS:
    feature start <name> [desc]       Start a new feature (creates milestone)
    feature finish [options] [target] Finish current feature
    
    hotfix start <name> [desc]        Start a hotfix (creates issue)
    hotfix finish [options] [target]  Finish current hotfix
    
    sync milestones                   List active milestones
    
    config                            Show current config
    init                              Initialize project configuration

OPTIONS for finish:
    --force-create-mr                 Force create MR even if one exists
    --auto-merge                      Auto-merge MR after creation

EXAMPLES:
    flow3 feature start user-auth "Add user authentication"
    flow3 feature finish --auto-merge
    flow3 hotfix start critical-bug "Fix critical security issue"
    flow3 hotfix finish --force-create-mr develop
    flow3 sync milestones

EOF
}

# 显示配置
show_config() {
    local git_root=$(get_git_root)
    if [ -z "$git_root" ]; then
        log_error "Not in a git repository"
        exit 1
    fi
    
    log_info "Current configuration:"
    echo "DEFAULT_TARGET_BRANCH=$DEFAULT_TARGET_BRANCH"
    echo "FEATURE_PREFIX=$FEATURE_PREFIX"
    echo "HOTFIX_PREFIX=$HOTFIX_PREFIX"
    
    if [ -f "$git_root/.flow3/config" ]; then
        echo ""
        log_info "Project config ($git_root/.flow3/config):"
        cat "$git_root/.flow3/config"
    fi
    
    if [ -f "$git_root/.flow3/branch_milestones" ]; then
        echo ""
        log_info "Branch-Milestone associations:"
        cat "$git_root/.flow3/branch_milestones"
    fi
}

# 初始化项目配置
init_project_config() {
    local git_root=$(get_git_root)
    if [ -z "$git_root" ]; then
        log_error "Not in a git repository"
        exit 1
    fi
    
    mkdir -p "$git_root/.flow3"
    if [ ! -f "$git_root/.flow3/config" ]; then
        cat > "$git_root/.flow3/config" << EOF
# Project-specific flow3 configuration
# DEFAULT_TARGET_BRANCH=main
# FEATURE_PREFIX=version/
# HOTFIX_PREFIX=hotfix/
EOF
        log_info "Project config created at $git_root/.flow3/config"
    else
        log_warn "Project config already exists at $git_root/.flow3/config"
    fi
}

# 主函数
main() {
    check_dependencies
    load_config
    
    case "${1:-}" in
        "feature")
            case "${2:-}" in
                "start") feature_start "$3" "$4" ;;
                "finish") shift 2; feature_finish "$@" ;;
                *) log_error "Unknown feature command: $2"; show_help; exit 1 ;;
            esac
            ;;
        "hotfix")
            case "${2:-}" in
                "start") hotfix_start "$3" "$4" ;;
                "finish") shift 2; hotfix_finish "$@" ;;
                *) log_error "Unknown hotfix command: $2"; show_help; exit 1 ;;
            esac
            ;;
        "sync")
            case "${2:-}" in
                "milestones") sync_milestones ;;
                *) log_error "Unknown sync command: $2"; show_help; exit 1 ;;
            esac
            ;;
        "config") show_config ;;
        "init") init_project_config ;;
        "help"|"-h"|"--help") show_help ;;
        "version"|"-v"|"--version") echo "Flow3 v$VERSION" ;;
        "") show_help ;;
        *) log_error "Unknown command: $1"; show_help; exit 1 ;;
    esac
}

main "$@"
