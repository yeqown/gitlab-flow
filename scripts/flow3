#!/bin/bash

set -e

VERSION="1.0.0"

# 默认配置
DEFAULT_TARGET_BRANCH="main"
FEATURE_PREFIX="version/"
HOTFIX_PREFIX="hotfix/"
AUTO_CREATE_MR="true"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 日志函数
log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# 检查依赖
check_dependencies() {
    command -v glab >/dev/null || { log_error "glab is required but not installed"; exit 1; }
    command -v git >/dev/null || { log_error "git is required but not installed"; exit 1; }
}

# 加载项目配置
load_config() {
    local config_file=".flow3/config"
    if [ -f "$config_file" ]; then
        log_info "Loading project config from $config_file"
        source "$config_file"
    fi
}

# 保存分支和milestone关联
save_branch_milestone() {
    local branch="$1"
    local milestone="$2"
    mkdir -p ".flow3"
    echo "$branch:$milestone" >> ".flow3/branch_milestones"
}

# 获取分支关联的milestone
get_branch_milestone() {
    local branch="$1"
    if [ -f ".flow3/branch_milestones" ]; then
        grep "^$branch:" ".flow3/branch_milestones" | cut -d':' -f2
    fi
}

# 移除分支milestone关联
remove_branch_milestone() {
    local branch="$1"
    if [ -f ".flow3/branch_milestones" ]; then
        grep -v "^$branch:" ".flow3/branch_milestones" > ".flow3/branch_milestones.tmp" || true
        mv ".flow3/branch_milestones.tmp" ".flow3/branch_milestones"
    fi
}

# 获取当前分支
get_current_branch() {
    git branch --show-current
}

# 功能：开始 feature
feature_start() {
    local name="$1"
    local milestone="$2"
    
    [ -z "$name" ] && { log_error "Feature name is required"; exit 1; }
    
    local branch_name="${FEATURE_PREFIX}${name}"
    
    log_info "Starting feature: $name"
    
    # 切换到主分支并更新
    git checkout "$DEFAULT_TARGET_BRANCH"
    git pull origin "$DEFAULT_TARGET_BRANCH"
    
    # 创建新分支
    git checkout -b "$branch_name"
    
    log_info "Created branch: $branch_name"
    
    # 如果指定了 milestone，保存关联并创建 issue
    if [ -n "$milestone" ]; then
        save_branch_milestone "$branch_name" "$milestone"
        log_info "Associated branch with milestone: $milestone"
        
        log_info "Creating issue for milestone: $milestone"
        glab issue create \
            --title "Feature: $name" \
            --milestone "$milestone" \
            --assignee "@me" || log_warn "Failed to create issue"
    fi
}

# 功能：完成 feature
feature_finish() {
    local target="${1:-$DEFAULT_TARGET_BRANCH}"
    local current_branch=$(get_current_branch)
    
    # 检查是否在 feature 分支
    if [[ ! "$current_branch" =~ ^${FEATURE_PREFIX} ]]; then
        log_error "Not on a feature branch"
        exit 1
    fi
    
    log_info "Finishing feature: $current_branch"
    
    # 推送当前分支
    git push -u origin "$current_branch"
    
    # 创建 MR
    if [ "$AUTO_CREATE_MR" = "true" ]; then
        log_info "Creating merge request"
        
        # 获取关联的milestone
        local milestone=$(get_branch_milestone "$current_branch")
        local mr_args="--source-branch $current_branch --target-branch $target --title ${current_branch#$FEATURE_PREFIX} --assignee @me"
        
        if [ -n "$milestone" ]; then
            log_info "Using associated milestone: $milestone"
            glab mr create --title "${current_branch#$FEATURE_PREFIX}" --description "Feature: ${current_branch#$FEATURE_PREFIX}" --source-branch "$current_branch" --target-branch "$target" --milestone "$milestone" --assignee "@me" --yes || log_warn "Failed to create MR"
        else
            glab mr create --title "${current_branch#$FEATURE_PREFIX}" --description "Feature: ${current_branch#$FEATURE_PREFIX}" --source-branch "$current_branch" --target-branch "$target" --assignee "@me" --yes || log_warn "Failed to create MR"
        fi
        
        # 清理分支milestone关联
        remove_branch_milestone "$current_branch"
    fi
}

# Issue 工作流：开始
issue_start() {
    local issue_id="$1"
    
    [ -z "$issue_id" ] && { log_error "Issue ID is required"; exit 1; }
    
    # 获取 issue 信息
    local issue_info=$(glab issue view "$issue_id" --output json 2>/dev/null)
    if [ $? -ne 0 ]; then
        log_error "Issue #$issue_id not found"
        exit 1
    fi
    
    local issue_title=$(echo "$issue_info" | grep -o '"title":"[^"]*"' | cut -d'"' -f4)
    local milestone_id=$(echo "$issue_info" | grep -o '"milestone":{"id":[0-9]*' | grep -o '[0-9]*$')
    local branch_name="${FEATURE_PREFIX}issue-${issue_id}"
    
    log_info "Starting work on issue #$issue_id: $issue_title"
    
    # 切换到主分支并更新
    git checkout "$DEFAULT_TARGET_BRANCH"
    git pull origin "$DEFAULT_TARGET_BRANCH"
    
    # 创建分支
    git checkout -b "$branch_name"
    
    log_info "Created branch: $branch_name"
    
    # 如果issue有milestone，保存关联
    if [ -n "$milestone_id" ]; then
        save_branch_milestone "$branch_name" "$milestone_id"
        log_info "Associated branch with milestone: $milestone_id"
    fi
}

# Issue 工作流：完成
issue_finish() {
    local current_branch=$(get_current_branch)
    
    # 提取 issue ID
    local issue_id=$(echo "$current_branch" | grep -o 'issue-[0-9]*' | cut -d'-' -f2)
    
    if [ -z "$issue_id" ]; then
        log_error "Not on an issue branch"
        exit 1
    fi
    
    log_info "Finishing issue #$issue_id"
    
    # 推送分支
    git push -u origin "$current_branch"
    
    # 获取关联的milestone
    local milestone=$(get_branch_milestone "$current_branch")
    
    if [ -n "$milestone" ]; then
        log_info "Using associated milestone: $milestone"
        glab mr create --title "Resolve #$issue_id" --description "Closes #$issue_id" --source-branch "$current_branch" --target-branch "$DEFAULT_TARGET_BRANCH" --milestone "$milestone" --assignee "@me" --yes
    else
        glab mr create --title "Resolve #$issue_id" --description "Closes #$issue_id" --source-branch "$current_branch" --target-branch "$DEFAULT_TARGET_BRANCH" --assignee "@me" --yes
    fi
    
    # 清理分支milestone关联
    remove_branch_milestone "$current_branch"
}

# 热修复：开始
hotfix_start() {
    local name="$1"
    
    [ -z "$name" ] && { log_error "Hotfix name is required"; exit 1; }
    
    local branch_name="${HOTFIX_PREFIX}${name}"
    
    log_info "Starting hotfix: $name"
    
    git checkout "$DEFAULT_TARGET_BRANCH"
    git pull origin "$DEFAULT_TARGET_BRANCH"
    git checkout -b "$branch_name"
    
    log_info "Created hotfix branch: $branch_name"
}

# 热修复：完成
hotfix_finish() {
    local current_branch=$(get_current_branch)
    
    if [[ ! "$current_branch" =~ ^${HOTFIX_PREFIX} ]]; then
        log_error "Not on a hotfix branch"
        exit 1
    fi
    
    log_info "Finishing hotfix: $current_branch"
    
    git push -u origin "$current_branch"
    
    glab mr create \
        --title "Hotfix: ${current_branch#$HOTFIX_PREFIX}" \
        --description "Hotfix: ${current_branch#$HOTFIX_PREFIX}" \
        --source-branch "$current_branch" \
        --target-branch "$DEFAULT_TARGET_BRANCH" \
        --assignee "@me" \
        --yes
}

# 同步 milestones
sync_milestones() {
    log_info "Syncing milestones..."
    glab api "projects/:id/milestones?state=active" | \
        grep -E '"title"|"id"' | \
        paste - - | \
        sed 's/.*"id":\([0-9]*\).*"title":"\([^"]*\)".*/\1: \2/'
}

# 显示帮助
show_help() {
    cat << EOF
Flow3 v$VERSION - GitLab workflow tool based on glab (3rd generation)

USAGE:
    flow3 <command> [options]

COMMANDS:
    feature start <name> [milestone]  Start a new feature
    feature finish [target-branch]    Finish current feature
    
    issue start <issue-id>            Start working on an issue
    issue finish                      Finish current issue
    
    hotfix start <name>               Start a hotfix
    hotfix finish                     Finish current hotfix
    
    sync milestones                   List active milestones
    
    config                            Show current config
    init                              Initialize project configuration

EXAMPLES:
    flow3 feature start user-auth 5
    flow3 issue start 123
    flow3 hotfix start critical-bug
    flow3 sync milestones

EOF
}

# 显示配置
show_config() {
    log_info "Current configuration:"
    echo "DEFAULT_TARGET_BRANCH=$DEFAULT_TARGET_BRANCH"
    echo "FEATURE_PREFIX=$FEATURE_PREFIX"
    echo "HOTFIX_PREFIX=$HOTFIX_PREFIX"
    echo "AUTO_CREATE_MR=$AUTO_CREATE_MR"
    
    if [ -f ".flow3/config" ]; then
        echo ""
        log_info "Project config (.flow3/config):"
        cat ".flow3/config"
    fi
    
    if [ -f ".flow3/branch_milestones" ]; then
        echo ""
        log_info "Branch-Milestone associations:"
        cat ".flow3/branch_milestones"
    fi
}

# 初始化项目配置
init_project_config() {
    mkdir -p ".flow3"
    if [ ! -f ".flow3/config" ]; then
        cat > ".flow3/config" << EOF
# Project-specific flow3 configuration
# DEFAULT_TARGET_BRANCH=main
# FEATURE_PREFIX=version/
# HOTFIX_PREFIX=hotfix/
# AUTO_CREATE_MR=true
EOF
        log_info "Project config created at .flow3/config"
    else
        log_warn "Project config already exists at .flow3/config"
    fi
}

# 主函数
main() {
    check_dependencies
    load_config
    
    case "${1:-}" in
        "feature")
            case "${2:-}" in
                "start") feature_start "$3" "$4" ;;
                "finish") feature_finish "$3" ;;
                *) log_error "Unknown feature command: $2"; show_help; exit 1 ;;
            esac
            ;;
        "issue")
            case "${2:-}" in
                "start") issue_start "$3" ;;
                "finish") issue_finish ;;
                *) log_error "Unknown issue command: $2"; show_help; exit 1 ;;
            esac
            ;;
        "hotfix")
            case "${2:-}" in
                "start") hotfix_start "$3" ;;
                "finish") hotfix_finish ;;
                *) log_error "Unknown hotfix command: $2"; show_help; exit 1 ;;
            esac
            ;;
        "sync")
            case "${2:-}" in
                "milestones") sync_milestones ;;
                *) log_error "Unknown sync command: $2"; show_help; exit 1 ;;
            esac
            ;;
        "config") show_config ;;
        "init") init_project_config ;;
        "help"|"-h"|"--help") show_help ;;
        "version"|"-v"|"--version") echo "Flow3 v$VERSION" ;;
        "") show_help ;;
        *) log_error "Unknown command: $1"; show_help; exit 1 ;;
    esac
}

main "$@"
